# =============================================================================
# ai-quote-agent — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the required values.
#
# Nesting convention: double underscore (__) separates section from key.
#   Example: DATABASE__URL sets Settings.database.url
# =============================================================================

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Database migrations (run after setting DATABASE__URL):
#   alembic upgrade head    — apply all migrations
#   alembic revision --autogenerate -m "description"  — create new migration
#   alembic downgrade -1    — rollback last migration
DATABASE__URL=postgresql://user:password@localhost:5432/quote_agent
DATABASE__ECHO=false

# ── LLM Provider ─────────────────────────────────────────────────────────────
LLM__API_KEY=sk-your-key-here
LLM__BASE_URL=https://api.openai.com/v1
LLM__DEFAULT_MODEL=gpt-4o
LLM__SIMPLE_MODEL=gpt-4o-mini
LLM__COMPLEX_MODEL=gpt-4o
LLM__TIMEOUT=60
LLM__MAX_RETRIES=3

# ── ERP (Odoo) ───────────────────────────────────────────────────────────────
ERP__URL=https://your-odoo-instance.com
ERP__DATABASE=your-odoo-db
ERP__USERNAME=your-odoo-user
ERP__API_KEY=your-odoo-api-key

# ── Email (IMAP) ─────────────────────────────────────────────────────────────
EMAIL__IMAP_SERVER=imap.your-provider.com
EMAIL__IMAP_PORT=993
EMAIL__USERNAME=quotes@your-domain.com
EMAIL__PASSWORD=your-email-password
EMAIL__FOLDER=INBOX
EMAIL__POLL_INTERVAL=60

# ── Notifications ────────────────────────────────────────────────────────────
NOTIFICATION__CHANNEL=teams
NOTIFICATION__TEAMS_WEBHOOK_URL=https://your-teams-webhook-url

# ── Application ──────────────────────────────────────────────────────────────
APP__NAME=ai-quote-agent
APP__VERSION=0.1.0
APP__DEBUG=false
APP__LOG_LEVEL=INFO
APP__API_HOST=0.0.0.0
APP__API_PORT=8000
